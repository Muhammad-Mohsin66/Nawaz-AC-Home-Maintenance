# Nawaz AC & Home Maintenance - Backend Environment Variables
PORT=5001
# Example MongoDB connection string (Replace with your Atlas or local connection string in .env)
# e.g.: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nawaz_maintenance?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/nawaz_maintenance
NODE_ENV=development
